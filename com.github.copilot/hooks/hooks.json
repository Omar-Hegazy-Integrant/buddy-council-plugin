{
  "version": 1,
  "_comment": "Copilot CLI and VS Code hooks (Agent Plugins format: they read only this file; Claude Code reads hooks/hooks.json — same scripts, same behavior). Hook commands run with cwd = the plugin directory, and PLUGIN_ROOT is set to it.",
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "\"${PLUGIN_ROOT:-.}\"/hooks/validate-bash.sh",
        "matcher": "bash",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "\"${PLUGIN_ROOT:-.}\"/hooks/auto-approve-plugin-writes.sh",
        "matcher": "create|edit|write",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "\"${PLUGIN_ROOT:-.}\"/hooks/auto-approve-mcp.sh",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "\"${PLUGIN_ROOT:-.}\"/hooks/log-tool-use.sh",
        "timeoutSec": 10
      }
    ],
    "postToolUseFailure": [
      {
        "type": "command",
        "bash": "\"${PLUGIN_ROOT:-.}\"/hooks/log-tool-use.sh",
        "timeoutSec": 10
      }
    ]
  }
}
