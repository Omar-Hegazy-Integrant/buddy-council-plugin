{
  "name": "bc",
  "description": "Multi-agent requirements/test-case analysis — contradiction detection, alignment validation, and cross-artifact reasoning",
  "version": "0.34.0",
  "author": {
    "name": "Omar Hegazy"
  },
  "repository": "https://github.com/Omar-Hegazy-Integrant/buddy-council-plugin",
  "license": "MIT",
  "keywords": ["requirements", "test-cases", "contradictions", "testrail", "jama", "qa"],
  "mcpServers": {
    "testrail": {
      "type": "stdio",
      "command": "sh",
      "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/bc-mcp", "testrail"]
    },
    "jama": {
      "type": "stdio",
      "command": "sh",
      "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/bc-mcp", "jama"]
    },
    "atlassian": {
      "type": "stdio",
      "command": "sh",
      "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/bc-mcp", "atlassian"]
    },
    "appium": {
      "type": "stdio",
      "command": "sh",
      "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/bc-mcp", "appium"]
    }
  },
  "agents": [
    "./com.github.copilot/agents/coverage-agent.agent.md",
    "./com.github.copilot/agents/data-collector.agent.md",
    "./com.github.copilot/agents/onboarding-agent.agent.md",
    "./com.github.copilot/agents/scenario-mapping-agent.agent.md",
    "./com.github.copilot/agents/ticket-validation-agent.agent.md",
    "./com.github.copilot/agents/vnv-sprint-prep-agent.agent.md"
  ]
}
