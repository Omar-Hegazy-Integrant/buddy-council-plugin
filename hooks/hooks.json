{
  "hooks": {
    "agentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/auto-export-session-logs.sh",
            "description": "Auto-export session logs dataset after each assistant response",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/validate-bash.sh",
            "description": "Hard-block destructive Bash; auto-approve the plugin's curated read-only commands",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/auto-approve-mcp.sh",
            "description": "Auto-approve read-only MCP fetches (testrail/github/jira get_*); write tools still prompt",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
